# Nova — Meta AI Developer Hackathon. Copy to .env (never committed) or export in your shell.
# Meta Model API key (Muse Spark, Wonder, Muse Image, Voice Transcribe, SAM 3.1). Read from MODEL_API_KEY or META_API_KEY.
META_API_KEY=
# Baseten key for Muse Spark Open (open weights), model meta-models/muse-spark-open.
BASETEN_API_KEY=
# Optional, non-model services (web search). Leave empty to skip.
TAVILY_API_KEY=
# Keyless demo: replays recorded real runs (demo/traces), no network, no key.
NOVA_DEMO_REPLAY=0
